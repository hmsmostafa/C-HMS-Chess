<Window x:Class="HMS_Chess.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HMS Chess Environment" Height="720" Width="720" WindowStartupLocation="CenterScreen">

    <Grid Background="#161512">
        <!-- Main Board Base Layout -->
        <Border Padding="20" BorderBrush="#2a2824" BorderThickness="2" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <UniformGrid x:Name="ChessBoardGrid" Rows="8" Columns="8" Width="640" Height="640"/>
        </Border>

        <!-- Lichess-style Promotion Modal Popup Layer -->
        <Grid x:Name="PromotionOverlay" Visibility="Collapsed" Background="#99000000">
            <Border Background="#262522" CornerRadius="8" BorderBrush="#363532" BorderThickness="2" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="15">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Choose Promotion Piece" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <StackPanel x:Name="PromotionOptionsPanel" Orientation="Horizontal"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
